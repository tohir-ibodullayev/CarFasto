# Copy to .env (or set these in your host's dashboard). No secrets are required.

# Port the Node server listens on. Most hosts inject PORT automatically.
PORT=3000
# Interface to bind. 0.0.0.0 lets phones on your LAN / the host's proxy reach it.
HOST=0.0.0.0

# Public HTTPS origin used for the QR code / join links, e.g. https://carfasto.onrender.com
# Leave empty to use whatever origin the host page was opened from (or RENDER_EXTERNAL_URL on Render).
# Must be ONLY the origin — do not append NODE_ENV or other variables to this value.
PUBLIC_ORIGIN=

# Keyboard simulation (dev-only simulated controllers). Defaults to true in development
# and false when NODE_ENV=production.
ENABLE_KEYBOARD_SIM=

# How long a disconnected player's seat is reserved (ms).
RECONNECT_WINDOW_MS=90000
# Rooms with nobody connected are deleted after this long (ms).
ROOM_IDLE_TIMEOUT_MS=600000
# Upper bound on simultaneous rooms kept in memory.
MAX_ROOMS=500

# Only needed if the frontend is served from a different origin than the backend.
# CORS_ORIGINS=https://my-frontend.example
# Client build-time variable (Vite) pointing the frontend at a separate backend origin.
# VITE_SERVER_URL=https://my-backend.example

# Dev only: port of the Vite dev server (the API server stays on PORT).
# CLIENT_DEV_PORT=5173
